from typing import List, Dict, Any
from pathlib import Path

try:
    from ultralytics import YOLO
except Exception:  # pragma: no cover
    YOLO = None


class YOLODetector:
    """Simple YOLO wrapper for orchard and flood detection tasks."""

    def __init__(self, model_name: str = "yolov8n.pt"):
        self.model_name = model_name
        self.model = YOLO(model_name) if YOLO is not None else None

    def detect(self, image_path: str) -> List[Dict[str, Any]]:
        if self.model is None:
            raise RuntimeError(
                "ultralytics is not installed or the YOLO model could not be loaded. "
                "Install the project requirements and ensure the model file exists."
            )

        results = self.model(image_path)
        detections: List[Dict[str, Any]] = []

        for result in results:
            for box in result.boxes:
                cls_id = int(box.cls[0])
                cls_name = result.names.get(cls_id, str(cls_id))
                confidence = float(box.conf[0])
                xyxy = box.xyxy[0].tolist()
                x1, y1, x2, y2 = [float(v) for v in xyxy]

                detections.append(
                    {
                        "class": cls_name,
                        "confidence": confidence,
                        "bbox": [x1, y1, x2, y2],
                    }
                )

        return detections


if __name__ == "__main__":
    detector = YOLODetector()
    print("Detector initialized. Pass an image path to detect() to run inference.")
